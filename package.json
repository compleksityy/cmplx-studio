{
  "name": "cmplx-studio",
  "productName": "CMPLX Studio",
  "version": "1.0.0",
  "description": "CMPLX Studio - a desktop AI-powered code editor and development environment",
  "main": "dist/main/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "rebuild": "electron-rebuild -f -w node-pty",
    "package": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux",
    "package:linux:appimage": "npm run build && electron-builder --linux AppImage",
    "package:linux:deb": "npm run build && electron-builder --linux deb",
    "package:linux:rpm": "npm run build && electron-builder --linux rpm",
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "npm run build:electron && electron scripts/verify-e2e.js",
    "test:ollama": "electron scripts/verify-ollama.js",
    "test:live": "electron scripts/verify-live-ollama.js",
    "test:launcher": "npm run build:electron && electron scripts/verify-ollama-launcher.js && electron scripts/verify-launcher-lifecycle.js",
    "test:ui": "npm run build && electron scripts/verify-theme.js"
  },
  "keywords": [
    "electron",
    "react",
    "code-editor",
    "ai-assistant",
    "ollama"
  ],
  "author": "CMPLX Studio Team",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "vite": "^5.1.0",
    "vitest": "^2.1.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.47.0",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
